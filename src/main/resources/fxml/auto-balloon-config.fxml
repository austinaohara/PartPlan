<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="360.0" prefWidth="560.0" stylesheets="@../styles/main.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AutoBalloonSettingsController">
    <top>
        <VBox spacing="8.0" styleClass="top-bar">
            <padding>
                <Insets bottom="14.0" left="18.0" right="18.0" top="18.0" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label styleClass="panel-title" text="OpenAI Auto-Balloon Settings" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#onSaveSettings" styleClass="primary-button" text="Save" />
                <Button mnemonicParsing="false" onAction="#onClearSettings" styleClass="secondary-button" text="Clear" />
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox maxWidth="520.0" spacing="12.0" styleClass="welcome-shell">
            <padding>
                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
            </padding>
            <Label styleClass="editor-copy" text="The selected page is sent to the OpenAI Responses API and the returned callouts are applied as local unsaved bubbles." wrapText="true" />

            <VBox spacing="6.0" styleClass="editor-card">
                <padding>
                    <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                </padding>
                <Label styleClass="field-label" text="OpenAI API Key" />
                <PasswordField fx:id="apiKeyField" promptText="sk-..." />
                <Label styleClass="editor-copy" text="Stored locally in this workspace. Do not commit this file to source control." wrapText="true" />
            </VBox>

            <VBox spacing="6.0" styleClass="editor-card">
                <padding>
                    <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                </padding>
                <Label styleClass="field-label" text="Model" />
                <ComboBox fx:id="modelComboBox" />
                <Label styleClass="editor-copy" text="Use a lower-cost model like gpt-5.4-mini, or switch to gpt-5.5 if you need better extraction quality." wrapText="true" />
            </VBox>

            <VBox spacing="6.0">
                <Label styleClass="field-label" text="Settings File" />
                <Label fx:id="storagePathLabel" styleClass="field-value" wrapText="true" />
                <Label fx:id="statusLabel" styleClass="editor-copy" wrapText="true" />
            </VBox>
        </VBox>
    </center>
</BorderPane>

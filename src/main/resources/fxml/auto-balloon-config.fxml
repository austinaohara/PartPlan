<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" stylesheets="@../styles/main.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AutoBalloonSettingsController">
    <top>
        <VBox spacing="10.0" styleClass="top-bar">
            <padding>
                <Insets bottom="20.0" left="28.0" right="28.0" top="28.0" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <Label styleClass="screen-title" text="OpenAI Auto-Balloon Settings" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#onSaveSettings" styleClass="primary-button" text="Save" />
                <Button mnemonicParsing="false" onAction="#onClearSettings" styleClass="secondary-button" text="Clear" />
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox maxWidth="760.0" spacing="18.0" styleClass="welcome-shell">
            <padding>
                <Insets bottom="36.0" left="36.0" right="36.0" top="36.0" />
            </padding>
            <Label styleClass="welcome-copy" text="The auto-balloon feature sends the selected drawing page to the OpenAI Responses API and applies the returned callouts as local unsaved bubbles." wrapText="true" />

            <VBox spacing="8.0" styleClass="welcome-card">
                <Label styleClass="welcome-card-title" text="OpenAI API Key" />
                <PasswordField fx:id="apiKeyField" promptText="sk-..." />
                <Label styleClass="editor-copy" text="Stored locally in this workspace. Do not commit this file to source control." wrapText="true" />
            </VBox>

            <VBox spacing="8.0" styleClass="welcome-card">
                <Label styleClass="welcome-card-title" text="Model" />
                <ComboBox fx:id="modelComboBox" />
                <Label styleClass="editor-copy" text="Use a lower-cost model like gpt-5.4-mini, or switch to gpt-5.5 if you need better extraction quality." wrapText="true" />
            </VBox>

            <VBox spacing="6.0">
                <Label styleClass="field-label" text="Settings File" />
                <Label fx:id="storagePathLabel" styleClass="field-value" wrapText="true" />
                <Label fx:id="statusLabel" styleClass="editor-copy" wrapText="true" />
            </VBox>
        </VBox>
    </center>
</BorderPane>

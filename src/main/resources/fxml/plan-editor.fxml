<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.Group?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<BorderPane fx:id="root" focusTraversable="true" prefHeight="700.0" prefWidth="1100.0" stylesheets="@../styles/main.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.PlanEditorController">
    <top>
        <VBox spacing="14.0" styleClass="top-bar">
            <padding>
                <Insets bottom="18.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <VBox alignment="CENTER_LEFT" spacing="4.0">
                    <Label fx:id="planTitleLabel" styleClass="screen-title" text="New Inspection Plan" />
                    <Label fx:id="planMetadataLabel" styleClass="welcome-subtitle" text="Draft · Pending" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#onReturnToPlans" styleClass="secondary-button" text="Inspection Plans" />
                <Button mnemonicParsing="false" onAction="#onReturnToHub" styleClass="secondary-button" text="Return to Hub" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Button fx:id="savePlanButton" mnemonicParsing="false" onAction="#onSavePlan" styleClass="primary-button" text="Save Draft" />
                <Button fx:id="completePlanButton" mnemonicParsing="false" onAction="#onCompletePlan" styleClass="primary-button" text="Complete Plan" />
                <Button fx:id="createRevisionButton" mnemonicParsing="false" onAction="#onCreateRevision" styleClass="secondary-button" text="Create Revision" />
                <Button fx:id="addPageButton" mnemonicParsing="false" onAction="#onImportDrawing" styleClass="primary-button" text="Add Page" />
                <HBox fx:id="autoBalloonButtonShell" alignment="CENTER_LEFT" spacing="2.0" styleClass="secondary-button,auto-balloon-shell">
                    <Button fx:id="autoBalloonSettingsButton" mnemonicParsing="false" onAction="#onOpenAutoBalloonSettings" styleClass="auto-balloon-segment-button" text="⚙">
                        <tooltip>
                            <Tooltip text="OpenAI auto-balloon settings" />
                        </tooltip>
                    </Button>
                    <Button fx:id="autoBalloonButton" mnemonicParsing="false" onAction="#onAutoBalloonPage" styleClass="auto-balloon-segment-button" text="Auto-Balloon Page" />
                </HBox>
                <Label fx:id="planUnsavedLabel" managed="false" styleClass="toolbar-pill" text="Unsaved changes" visible="false" />
            </HBox>
        </VBox>
    </top>

    <left>
        <HBox>
            <!-- Expanded left panel -->
            <VBox fx:id="leftPanel" prefWidth="310.0" styleClass="tool-window">
                <!-- Title bar: title on left, X on right -->
                <HBox alignment="CENTER_LEFT" styleClass="tool-window-header">
                    <Label styleClass="tool-window-title" text="Plan Outline" HBox.hgrow="ALWAYS" />
                    <HBox HBox.hgrow="ALWAYS" />
                    <Button onAction="#onToggleLeftPanel" styleClass="tool-window-close-btn" text="X" />
                </HBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minHeight="0.0" styleClass="panel-scroll-pane" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="10.0">
                            <padding>
                                <Insets bottom="16.0" left="16.0" right="16.0" top="12.0" />
                            </padding>
                            <Label styleClass="field-label" text="Pages" />
                            <ListView fx:id="planPagesListView" prefHeight="150.0" styleClass="saved-plans-list" />
                            <Label styleClass="field-label" text="Bubbles" />
                            <TextField fx:id="bubbleSearchField" promptText="Search by # or nameâ€¦" />
                            <HBox alignment="CENTER_LEFT" spacing="6.0">
                                <Label styleClass="field-label" text="Sort:" />
                                <ComboBox fx:id="bubbleSortComboBox" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                            </HBox>
                            <ListView fx:id="bubbleListView" prefHeight="180.0" styleClass="saved-plans-list" />
                            <Separator />
                            <Label styleClass="field-label" text="Drawing File" />
                            <Label fx:id="drawingFileNameLabel" styleClass="field-value" text="No drawing selected" wrapText="true" />
                            <Label styleClass="field-label" text="Drawing Path" />
                            <Label fx:id="drawingPathLabel" styleClass="field-value" text="" wrapText="true" />
                        </VBox>
                    </content>
                </ScrollPane>
            </VBox>

            <!-- Resize handle (right edge of left panel) -->
            <VBox fx:id="leftResizeHandle" prefWidth="5.0" styleClass="resize-handle-v" />

            <!-- Collapsed left strip -->
            <VBox fx:id="leftCollapsedTab" alignment="TOP_CENTER" managed="false" onMouseClicked="#onToggleLeftPanel" prefWidth="28.0" styleClass="tool-strip" visible="false">
                <Group>
                    <Label rotate="-90" styleClass="tool-strip-label" text="Plan Outline" />
                </Group>
            </VBox>
        </HBox>
    </left>

    <center>
        <StackPane styleClass="canvas-shell">
            <Label fx:id="emptyStateLabel" styleClass="empty-state" text="Add a drawing page to start this inspection plan." wrapText="true" />
            <Label fx:id="pdfPreviewLabel" managed="false" styleClass="empty-state" text="PDF selected. The file is saved with the plan, but PDF preview is not available in this editor." visible="false" wrapText="true" />
            <ScrollPane fx:id="drawingScrollPane" fitToHeight="false" fitToWidth="false" pannable="true" styleClass="drawing-scroll-pane">
                <content>
                    <Group>
                        <ImageView fx:id="drawingImageView" preserveRatio="true" smooth="true" />
                        <Pane fx:id="bubbleOverlayPane" pickOnBounds="true" />
                    </Group>
                </content>
            </ScrollPane>
        </StackPane>
    </center>

    <right>
        <HBox>
            <!-- Collapsed right strip -->
            <VBox fx:id="rightCollapsedTab" alignment="TOP_CENTER" managed="false" onMouseClicked="#onToggleRightPanel" prefWidth="28.0" styleClass="tool-strip" visible="false">
                <Group>
                    <Label rotate="90" styleClass="tool-strip-label" text="Bubble Data" />
                </Group>
            </VBox>

            <!-- Resize handle (left edge of right panel) -->
            <VBox fx:id="rightResizeHandle" prefWidth="5.0" styleClass="resize-handle-v" />

            <!-- Expanded right panel -->
            <VBox fx:id="rightPanel" prefWidth="310.0" styleClass="tool-window">
                <HBox alignment="CENTER_LEFT" styleClass="tool-window-header">
                    <Button onAction="#onToggleRightPanel" styleClass="tool-window-close-btn" text="X" />
                    <Label styleClass="tool-window-title" text="Bubble Data" HBox.hgrow="ALWAYS" />
                </HBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minHeight="0.0" styleClass="panel-scroll-pane" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="bubbleEditorPane" spacing="10.0">
                            <padding>
                                <Insets bottom="16.0" left="16.0" right="16.0" top="12.0" />
                            </padding>
                            <Label fx:id="bubbleModeLabel" styleClass="field-label" text="Default Bubble Settings" />
                            <Label fx:id="bubbleHintLabel" styleClass="field-value" text="Shift + Click to place a bubble. Ctrl + C to copy." wrapText="true" />
                            <Separator />
                            <Label styleClass="field-label" text="Bubble Number" />
                            <TextField fx:id="bubbleNumberField" promptText="Bubble number" />
                            <HBox alignment="CENTER_LEFT" spacing="6.0">
                                <CheckBox fx:id="useDefaultDiameterCheckBox" mnemonicParsing="false" selected="true" styleClass="compact-checkbox">
                                    <tooltip>
                                        <Tooltip text="Use the default diameter value" />
                                    </tooltip>
                                </CheckBox>
                                <Label styleClass="field-label" text="Diameter" />
                            </HBox>
                            <TextField fx:id="bubbleDiameterField" promptText="Bubble diameter" />
                            <HBox alignment="CENTER_LEFT" spacing="6.0">
                                <CheckBox fx:id="useDefaultColorCheckBox" mnemonicParsing="false" selected="true" styleClass="compact-checkbox">
                                    <tooltip>
                                        <Tooltip text="Use the default bubble color" />
                                    </tooltip>
                                </CheckBox>
                                <Label styleClass="field-label" text="Color" />
                            </HBox>
                            <TextField fx:id="bubbleColorField" promptText="#E53935" />
                            <Label styleClass="field-label" text="Characteristic" />
                            <TextField fx:id="characteristicField" promptText="Enter characteristic" />
                            <Label styleClass="field-label" text="Inspection Type" />
                            <ComboBox fx:id="inspectionTypeComboBox" />
                            <Label styleClass="field-label" text="Nominal Value" />
                            <TextField fx:id="nominalValueField" promptText="Optional numeric value" />
                            <Label styleClass="field-label" text="Lower Tolerance" />
                            <TextField fx:id="lowerToleranceField" promptText="Optional numeric value" />
                            <Label styleClass="field-label" text="Upper Tolerance" />
                            <TextField fx:id="upperToleranceField" promptText="Optional numeric value" />
                            <Label styleClass="field-label" text="Notes" />
                            <TextArea fx:id="bubbleNoteArea" prefRowCount="6" promptText="Enter notes for this bubble" wrapText="true" />
                            <HBox spacing="8.0">
                                <Button fx:id="saveBubbleButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#onSaveBubble" styleClass="primary-button" text="Save Defaults" HBox.hgrow="ALWAYS" />
                                <Button fx:id="copyBubbleButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#onCopyBubble" styleClass="copy-button" text="Copy" HBox.hgrow="ALWAYS">
                                    <tooltip><Tooltip text="Duplicate this bubble (Ctrl+D)" /></tooltip>
                                </Button>
                                <Button fx:id="deleteBubbleButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#onDeleteBubble" styleClass="danger-button" text="Delete" HBox.hgrow="ALWAYS" />
                            </HBox>
                        </VBox>
                    </content>
                </ScrollPane>
            </VBox>
        </HBox>
    </right>
</BorderPane>


<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="980.0" stylesheets="@../styles/main.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <center>
      <TableView fx:id="tableView" editable="true" prefHeight="200.0" prefWidth="200.0">
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <columns>
            <TableColumn fx:id="columnSequenceNumber" prefWidth="90.0" text="Bubble" />
             <TableColumn fx:id="columnCharacteristic" prefWidth="210.0" text="Characteristic" />
             <TableColumn fx:id="columnInspectionType" prefWidth="120.0" text="Type" />
             <TableColumn fx:id="columnNominalValue" prefWidth="120.0" text="Nominal" />
             <TableColumn fx:id="columnLowerTolerance" prefWidth="100.0" text="Tol -" />
             <TableColumn fx:id="columnUpperTolerance" prefWidth="100.0" text="Tol +" />
             <TableColumn fx:id="columnNote" prefWidth="240.0" text="Note" />
         </columns>
      </TableView>
   </center>
   <top>
      <VBox styleClass="top-bar" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <Label styleClass="screen-title" text="Bubble Table" />
                  <Label fx:id="currentPlanLabel" styleClass="field-label" text="PLAN_NAME_HERE" />
                  <Label fx:id="modeLabel" styleClass="toolbar-pill" text="Editable draft" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="18.0" left="24.0" right="24.0" top="24.0" />
         </padding></VBox>
   </top>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane fx:id="rootPane" prefHeight="700.0" prefWidth="1100.0" stylesheets="@../styles/main.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="FirebaseSetupController">
    <top>
        <VBox spacing="10.0" styleClass="top-bar">
            <padding>
                <Insets bottom="20.0" left="28.0" right="28.0" top="28.0" />
            </padding>
            <Label styleClass="screen-title" text="PartPlan" />
            <Label styleClass="welcome-subtitle" text="Set the Firebase project for this workspace before users can sign in." />
        </VBox>
    </top>

    <center>
        <HBox alignment="TOP_CENTER" fillHeight="true" spacing="24.0" styleClass="welcome-shell">
            <padding>
                <Insets bottom="28.0" left="36.0" right="36.0" top="28.0" />
            </padding>

            <VBox maxWidth="500.0" prefWidth="500.0" spacing="14.0" styleClass="welcome-card">
                <Label styleClass="welcome-card-title" text="Firebase Project Settings" />
                <Label styleClass="editor-copy" text="Use the web-app configuration values from Firebase Project Settings." wrapText="true" />

                <VBox spacing="10.0">
                    <HBox alignment="TOP_LEFT" spacing="12.0">
                        <VBox minWidth="0.0" spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="API Key" />
                            <PasswordField fx:id="apiKeyField" promptText="AIza..." />
                        </VBox>
                        <VBox minWidth="0.0" spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="Project ID" />
                            <TextField fx:id="projectIdField" promptText="your-project-id" />
                        </VBox>
                    </HBox>

                    <HBox alignment="TOP_LEFT" spacing="12.0">
                        <VBox minWidth="0.0" spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="App ID" />
                            <TextField fx:id="appIdField" promptText="1:1234567890:web:..." />
                        </VBox>
                        <VBox minWidth="0.0" spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="Storage Bucket" />
                            <TextField fx:id="storageBucketField" promptText="your-project.firebasestorage.app" />
                        </VBox>
                    </HBox>

                    <HBox alignment="TOP_LEFT" spacing="12.0">
                        <VBox minWidth="0.0" spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="Auth Domain (Optional)" />
                            <TextField fx:id="authDomainField" promptText="your-project.firebaseapp.com" />
                        </VBox>
                        <VBox minWidth="0.0" spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="Database ID (Optional)" />
                            <TextField fx:id="databaseIdField" promptText="(default)" />
                        </VBox>
                    </HBox>
                </VBox>

                <HBox spacing="10.0">
                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onSaveAndContinue" styleClass="primary-button welcome-card-button" text="Save and Continue" HBox.hgrow="ALWAYS" />
                    <Button fx:id="continueButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onOpenLogin" styleClass="secondary-button welcome-card-button" text="Open Sign In" HBox.hgrow="ALWAYS" />
                </HBox>

                <Label fx:id="statusLabel" styleClass="editor-copy" text="Enter the Firebase web-app settings for this project." wrapText="true" />
            </VBox>

            <VBox maxWidth="320.0" prefWidth="320.0" spacing="18.0" styleClass="welcome-card">
                <Label styleClass="welcome-card-title" text="Local Storage" />
                <Label styleClass="editor-copy" text="PartPlan stores the Firebase project config and saved session in a project-local folder." wrapText="true" />
                <Label styleClass="field-label" text="Folder" />
                <Label fx:id="storagePathLabel" styleClass="field-value" text=".partplan" wrapText="true" />
                <Region VBox.vgrow="ALWAYS" />
                <Label styleClass="editor-copy" text="If these files are missing or unreadable, this setup screen is shown before login." wrapText="true" />
            </VBox>
        </HBox>
    </center>
</BorderPane>

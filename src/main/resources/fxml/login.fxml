<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" prefHeight="700.0" prefWidth="1100.0" stylesheets="@../styles/main.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LoginController">
    <top>
        <VBox spacing="10.0" styleClass="top-bar">
            <padding>
                <Insets bottom="20.0" left="28.0" right="28.0" top="28.0" />
            </padding>
            <Label styleClass="screen-title" text="PartPlan" />
            <Label styleClass="welcome-subtitle" text="Sign in with the Firebase project already configured for this workspace." />
        </VBox>
    </top>

    <center>
        <HBox alignment="CENTER" spacing="24.0" styleClass="welcome-shell">
            <padding>
                <Insets bottom="36.0" left="36.0" right="36.0" top="36.0" />
            </padding>

            <VBox maxWidth="380.0" prefWidth="380.0" spacing="18.0" styleClass="welcome-card">
                <Label styleClass="welcome-card-title" text="Firebase Project" />
                <Label fx:id="projectSummaryLabel" styleClass="editor-copy" text="Project:" wrapText="true" />
                <Label styleClass="editor-copy" text="If you need to switch Firebase projects or repair saved settings, update them before signing in." wrapText="true" />
                <Region VBox.vgrow="ALWAYS" />
                <Button fx:id="editProjectButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onEditProjectSettings" styleClass="secondary-button welcome-card-button" text="Edit Firebase Settings" />
            </VBox>

            <VBox maxWidth="360.0" prefWidth="360.0" spacing="18.0" styleClass="welcome-card">
                <Label styleClass="welcome-card-title" text="Sign In" />
                <Label styleClass="editor-copy" text="Use the Email/Password provider enabled in Firebase Authentication." wrapText="true" />

                <Label styleClass="field-label" text="Email" />
                <TextField fx:id="emailField" promptText="you@example.com" />

                <Label styleClass="field-label" text="Password" />
                <PasswordField fx:id="passwordField" promptText="Password" />

                <VBox spacing="10.0">
                    <Button fx:id="signInButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onSignIn" styleClass="primary-button welcome-card-button" text="Sign In" />
                    <Button fx:id="signUpButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onSignUp" styleClass="secondary-button welcome-card-button" text="Create Account" />
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <ProgressIndicator fx:id="progressIndicator" maxHeight="24.0" maxWidth="24.0" prefHeight="24.0" prefWidth="24.0" progress="-1.0" />
                    <Label fx:id="statusLabel" styleClass="editor-copy" text="Sign in with the Firebase project configured for this workspace." wrapText="true" />
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
